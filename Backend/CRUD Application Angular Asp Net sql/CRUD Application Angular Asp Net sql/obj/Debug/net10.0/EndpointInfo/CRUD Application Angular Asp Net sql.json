{
  "openapi": "3.0.4",
  "info": {
    "title": "CRUD Application Angular Asp Net sql",
    "version": "1.0"
  },
  "paths": {
    "/api/MainCrud/GetAllStudent": {
      "get": {
        "tags": [
          "MainCrud"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/MainCrud/GetById": {
      "get": {
        "tags": [
          "MainCrud"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/MainCrud/AddStudent": {
      "post": {
        "tags": [
          "MainCrud"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudnetMaster"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/StudnetMaster"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/StudnetMaster"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/MainCrud/UpdateStudent/{id}": {
      "put": {
        "tags": [
          "MainCrud"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudnetMaster"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/StudnetMaster"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/StudnetMaster"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/MainCrud/DeleteStudent/{id}": {
      "delete": {
        "tags": [
          "MainCrud"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/MainCrud/SendEmail/Send": {
      "post": {
        "tags": [
          "MainCrud"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/EmailModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/MainCrud/LoginAndroleCheck/Login": {
      "post": {
        "tags": [
          "MainCrud"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/MainCrud/UserRegister/Register": {
      "post": {
        "tags": [
          "MainCrud"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginsTbl"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginsTbl"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginsTbl"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/MainCrud/Gettoken/GetToken": {
      "get": {
        "tags": [
          "MainCrud"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EmailModel": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "nullable": true
          },
          "subject": {
            "type": "string",
            "nullable": true
          },
          "body": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginDTO": {
        "type": "object",
        "properties": {
          "uname": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginsTbl": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "uname": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "roleId": {
            "type": "integer",
            "format": "int32"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "additionalProperties": false
      },
      "Role": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "uRole": {
            "type": "string",
            "nullable": true
          },
          "logins": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LoginsTbl"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "StudnetMaster": {
        "required": [
          "address",
          "city",
          "contact",
          "country",
          "cources",
          "dob",
          "email",
          "state",
          "studentname"
        ],
        "type": "object",
        "properties": {
          "studentid": {
            "type": "integer",
            "format": "int32"
          },
          "studentname": {
            "maxLength": 50,
            "minLength": 2,
            "type": "string"
          },
          "dob": {
            "type": "string",
            "format": "date"
          },
          "address": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          },
          "city": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "state": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "country": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "contact": {
            "type": "integer",
            "format": "int64"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "cources": {
            "minLength": 1,
            "type": "string"
          },
          "comment": {
            "maxLength": 300,
            "minLength": 0,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "MainCrud"
    }
  ]
}